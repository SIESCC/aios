# ============================================================
# AIOS Environment Configuration
# Copy this to .env and fill in values
# ============================================================

# ── Node Environment ────────────────────────────────────────
NODE_ENV=development

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=aios
POSTGRES_PASSWORD=aios_secret_change_me
POSTGRES_DB=aios_db
DATABASE_URL=postgresql://aios:aios_secret_change_me@localhost:5432/aios_db

# ── Redis ───────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret_change_me
REDIS_URL=redis://:redis_secret_change_me@localhost:6379

# ── Elasticsearch ───────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ── JWT Auth ────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_minimum_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── OpenAI (for AI summarization) ──────────────────────────
OPENAI_API_KEY=sk-...

# ── GitHub (for repo tracking) ─────────────────────────────
GITHUB_TOKEN=ghp_...

# ── App URLs ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_API_URL=http://localhost:4000/api

# ── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Worker Schedule (cron expressions) ─────────────────────
GITHUB_SCRAPE_CRON=0 */6 * * *
ARXIV_SCRAPE_CRON=0 */12 * * *
NEWS_SCRAPE_CRON=0 */3 * * *
TOOLS_SCRAPE_CRON=0 0 * * *
